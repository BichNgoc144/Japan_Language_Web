@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<div class="card">
    <p class="card__eyebrow">巻 04 — Bảo mật</p>
    <h1 class="card__title">Đổi mật khẩu</h1>
    <p class="card__subtitle">Nhập mật khẩu hiện tại và mật khẩu mới. Sau khi đổi, các thiết bị khác đang đăng nhập sẽ tự động bị đăng xuất.</p>

    <div asp-validation-summary="All" class="alert alert--error" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

    <form asp-action="ChangePassword" method="post" novalidate>
        <div class="field">
            <label asp-for="OldPassword"></label>
            <input asp-for="OldPassword" type="password" autocomplete="current-password">
            <span asp-validation-for="OldPassword"></span>
        </div>
        <div class="field">
            <label asp-for="NewPassword"></label>
            <input asp-for="NewPassword" type="password" autocomplete="new-password">
            <span asp-validation-for="NewPassword"></span>
        </div>
        <div class="field">
            <label asp-for="ConfirmNewPassword"></label>
            <input asp-for="ConfirmNewPassword" type="password" autocomplete="new-password">
            <span asp-validation-for="ConfirmNewPassword"></span>
        </div>
        <div class="btn-stack">
            <button type="submit" class="btn btn--primary">Đổi mật khẩu</button>
            <a asp-action="Profile" class="btn btn--ghost">Huỷ</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
