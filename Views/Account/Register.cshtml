@model RegisterEmailViewModel
@{
    ViewData["Title"] = "Đăng ký";
}

<div class="card">
    <p class="card__eyebrow">巻 02 — Đăng ký · Bước 1/3</p>
    <h1 class="card__title">Tạo tài khoản mới</h1>
    <p class="card__subtitle">Nhập email — chúng tôi gửi một mã OTP 6 số để xác thực trước khi bạn tạo mật khẩu.</p>

    <div asp-validation-summary="ModelOnly" class="alert alert--error" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

    <form asp-action="Register" method="post" novalidate>
        <div class="field">
            <label asp-for="Email"></label>
            <input asp-for="Email" type="email" autocomplete="email" placeholder="ban@vidu.com">
            <span asp-validation-for="Email"></span>
        </div>
        <button type="submit" class="btn btn--primary">Gửi mã OTP</button>
    </form>
    <p class="foot-note">Đã có tài khoản? <a asp-action="Login">Đăng nhập</a></p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
