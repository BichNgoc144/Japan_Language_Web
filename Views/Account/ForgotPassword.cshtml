@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="card">
    <p class="card__eyebrow">巻 03 — Khôi phục</p>
    <h1 class="card__title">Quên mật khẩu</h1>
    <p class="card__subtitle">Nhập email đã đăng ký — chúng tôi sẽ gửi liên kết đặt lại mật khẩu, hiệu lực trong 15 phút.</p>

    <div asp-validation-summary="All" class="alert alert--error" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

    <form asp-action="ForgotPassword" method="post" novalidate>
        <div class="field">
            <label asp-for="Email"></label>
            <input asp-for="Email" type="email" autocomplete="email" placeholder="ban@vidu.com">
            <span asp-validation-for="Email"></span>
        </div>
        <button type="submit" class="btn btn--primary">Gửi liên kết</button>
    </form>
    <p class="foot-note"><a asp-action="Login">← Quay lại đăng nhập</a></p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
