@model CreatePasswordViewModel
@{
    ViewData["Title"] = "Tạo mật khẩu";
}

<div class="card">
    <p class="card__eyebrow">巻 02 — Đăng ký · Bước 3/3</p>
    <h1 class="card__title">Tạo tài khoản</h1>
    <p class="card__subtitle">Bước cuối cùng — đặt tên đăng nhập và mật khẩu cho tài khoản của bạn.</p>

    <div asp-validation-summary="All" class="alert alert--error" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

    <form asp-action="CreatePassword" method="post" novalidate id="createPasswordForm">
        <input type="hidden" asp-for="Email">

        <div class="field">
            <label asp-for="Username"></label>
            <input asp-for="Username" autocomplete="username" placeholder="vd: an98">
            <span asp-validation-for="Username"></span>
        </div>

        <div class="field">
            <label asp-for="FullName"></label>
            <input asp-for="FullName" placeholder="Ví dụ: Nguyễn Văn An">
            <span asp-validation-for="FullName"></span>
        </div>

        <div class="suggest-row">
            <code id="suggestedPwd">Nhấn "Gợi ý" để tạo mật khẩu mạnh</code>
            <button type="button" class="link-btn" id="suggestBtn">Gợi ý</button>
        </div>

        <div class="field">
            <label asp-for="Password"></label>
            <input asp-for="Password" type="password" autocomplete="new-password">
            <span asp-validation-for="Password"></span>
        </div>
        <div class="field">
            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password">
            <span asp-validation-for="ConfirmPassword"></span>
        </div>

        <button type="submit" class="btn btn--primary">Hoàn tất đăng ký</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('suggestBtn').addEventListener('click', async function () {
            const res = await fetch('@Url.Action("GeneratePassword", "Account")');
            const data = await res.json();
            document.getElementById('suggestedPwd').textContent = data.password;
            document.getElementById('Password').value = data.password;
            document.getElementById('ConfirmPassword').value = data.password;
        });
    </script>
}
